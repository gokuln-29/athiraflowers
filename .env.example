# Copy to .env (local) or /etc/athira/athira.env (production, chmod 640, owned root:athira).
# NEVER commit real values.

# --- Brand (read only by src/config/site.ts) --------------------------------
NEXT_PUBLIC_SITE_NAME="Athira flowers"
NEXT_PUBLIC_SITE_NAME_AR="أثيرة للزهور"
NEXT_PUBLIC_SITE_DOMAIN="athiraflowers.ae"
NEXT_PUBLIC_SITE_URL="https://athiraflowers.ae"
# Public media origin (R2 custom domain in production, e.g. https://media.athiraflowers.ae)
NEXT_PUBLIC_MEDIA_URL="https://media.athiraflowers.ae"
NEXT_PUBLIC_VAT_BPS=500
# Optional, loaded only after cookie consent
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# --- Runtime ------------------------------------------------------------------
NODE_ENV=production
# 32+ random bytes, base64. Used to HMAC IPs/tokens and sign short-lived cookies.
APP_SECRET=""
# Comma separated extra origins allowed for state-changing requests (usually empty)
ALLOWED_ORIGINS=""

# --- Database (MySQL on 127.0.0.1, least-privilege app user) -------------------
DATABASE_URL="mysql://athira_app:CHANGE_ME@127.0.0.1:3306/athira"
# Used only by migrations/seed (DDL privileges); never loaded by the running app
DATABASE_MIGRATE_URL="mysql://athira_migrate:CHANGE_ME@127.0.0.1:3306/athira"

# --- Storage: r2 in production, local only for development ---------------------
STORAGE_DRIVER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="athira-media"
# Seconds a presigned upload URL stays valid
UPLOAD_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=10485760

# --- Email (Brevo transactional API) -------------------------------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="orders@athiraflowers.ae"
BREVO_SENDER_NAME="Athira flowers"
# Internal inbox for new enquiries / orders
NOTIFY_EMAIL="hello@athiraflowers.ae"

# --- Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Tabby / Tamara (scaffold only, not enabled) --------------------------------
TABBY_PUBLIC_KEY=""
TABBY_SECRET_KEY=""
TAMARA_API_TOKEN=""
TAMARA_NOTIFICATION_TOKEN=""
