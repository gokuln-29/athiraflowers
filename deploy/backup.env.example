# /etc/athira/backup.env  (root:root 600). Keep these credentials separate from the website's.
# Repository is encrypted client-side by restic. Use a backup-only account at the offsite provider.
RESTIC_REPOSITORY=rclone:gdrive-backup:athira-restic      # or s3:https://<account>.r2.cloudflarestorage.com/athira-backup (a DIFFERENT account from the media bucket)
RESTIC_PASSWORD_FILE=/etc/athira/restic.pass              # random 32+ chars; keep a copy in the offline vault, without it nothing can be restored
MYSQL_DEFAULTS_FILE=/etc/athira/mysql-backup.cnf          # [client] user=athira_backup password=... (SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER, PROCESS only)
DB_NAME=athira
R2_REMOTE=r2:athira-media                                 # rclone remote for the media bucket (read-only key); omit if media is backed up elsewhere
MEDIA_STAGE=/var/backups/athira-media
PING_URL=                                                 # healthchecks.io style: a missing ping raises the alert
ALERT_WEBHOOK=                                            # optional chat webhook
