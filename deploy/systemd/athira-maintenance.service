[Unit]
Description=Athira housekeeping (email retry, stale card orders, purges)
After=network-online.target mysql.service

[Service]
Type=oneshot
User=athira
Group=athira
WorkingDirectory=/srv/athira/current
ExecStart=/usr/bin/node --env-file=/etc/athira/athira.env --conditions react-server --import tsx scripts/maintenance.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
